# 打包产物
dist/
*.zip

# 系统文件
.DS_Store
Thumbs.db

# 本地配置
*.local

# 本地 issue / spec（不入库）
.scratch/

# 断言运行时的临时产物（用例工作目录）
# .work/ 是串行跑用的；.work-run/ 是总入口给并行跑准备的「一个用例文件一份工作根」
tests/.work/
tests/.work-run/

# 本机跑断言用的 busybox（随附本地，不入库）
tools/busybox/

# Python 缓存
__pycache__/
*.pyc

# 并行实施用的本地工作树（不入库）
.worktrees/

# 浏览器自动化产物（本机调试用，不入库）
.playwright-mcp/
