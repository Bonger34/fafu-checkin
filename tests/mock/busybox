#!/bin/sh
# ============================================================
# mock busybox —— 只接管「取当前时间」，其余 applet 透传给真实 busybox
#
# 为什么需要它：被测脚本一律用 "$BB" date ... 取时间，把 BB_OVERRIDE 指到
# 「转发到本文件的包装脚本」就等于给整条链路拨钟，不必改动被测源码。
# 包装脚本由 tests/harness.sh 的 t_bb_wrap 生成（它负责设置下面的 BB_REAL，
# 并把本文件当一个 sh 脚本跑起来）——**不要**把 BB_OVERRIDE 直接指向本文件：
# 本文件自身可执行时 BB_REAL 为空，会自我递归。
#
# 环境变量（由包装脚本与用例设置）：
#   BB_REAL        真实 busybox 的路径（必需；Windows 上是 busybox.exe）
#   MOCK_DATE_CTL  形如「2026-10-01 22:05」的文件；只影响 +%Y-%m-%d / +%Y%m%d /
#                  +%H:%M / +%H / +%M，其余格式（含 +%s）走真实时间
#   MOCK_DATE_FMT  仅输出一个格式串时的回退格式（默认 +%s）
#
# 当前用例只用到「透传」这一半；拨钟那一半留给需要跨日/时点判定的用例
# （设置 MOCK_DATE_CTL 即可）。
# ============================================================
BB_REAL="${BB_REAL:-busybox}"
MOCK_DATE_FMT="${MOCK_DATE_FMT:-+%s}"

# 拿不到真实 busybox 时明确失败：此时 exec 自己会变成 fork 炸弹，
# 而「找不到 busybox」在测试日志里表现为「全部断言莫名超时」，极难排查。
# 判据：PATH 上要有一个**真的 busybox 文件**；若它是 busybox ash 的内建 applet
# （`command -v` 只回一个名字），那也能用——但名字不是文件，不能当成路径。
if [ "$BB_REAL" = "busybox" ]; then
  if ! command -v busybox >/dev/null 2>&1; then
    echo "mock: 拿不到真实 busybox（BB_REAL 未设置，PATH 里也没有）；" >&2
    echo "mock: 请设置 TEST_BUSYBOX=<路径>，或把 busybox 放到 tools/busybox/。" >&2
    exit 127
  fi
fi

if [ "$1" = "date" ] && [ -n "${MOCK_DATE_CTL:-}" ] && [ -f "$MOCK_DATE_CTL" ]; then
  _d=$(cat "$MOCK_DATE_CTL")
  _fmt="${2:-$MOCK_DATE_FMT}"
  case "$_fmt" in
    +%Y-%m-%d) echo "${_d%% *}" ;;
    +%Y%m%d)   echo "${_d%% *}" | tr -d '-' ;;
    +%H:%M)    echo "${_d#* }" ;;
    +%H)       echo "${_d#* }" | cut -d: -f1 ;;
    +%M)       echo "${_d#* }" | cut -d: -f2 ;;
    *)         "$BB_REAL" date "$@" ;;
  esac
  exit 0
fi

exec "$BB_REAL" "$@"
