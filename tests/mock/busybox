#!/bin/sh
# ============================================================
# mock busybox —— 只接管「环境事实」这四处，其余 applet 透传给真实 busybox
#
# 为什么需要它：被测脚本一律用 "$BB" 调用 applet，把 BB_OVERRIDE 指到
# 「转发到本文件的包装脚本」就等于给整条链路换环境，不必改动被测源码。
# 包装脚本由 tests/harness.sh 的 t_bb_wrap 生成（它负责设置下面的 BB_REAL，
# 并把本文件当一个 sh 脚本跑起来）——**不要**把 BB_OVERRIDE 直接指向本文件：
# 本文件自身可执行时 BB_REAL 为空，会自我递归。
#
# 接管的四处（都是「本机没有 / 不可控」的环境事实，不是被测行为本身；
# 四个控制变量都不设时本文件完全等价于「透传给真实 busybox」）：
#   1) 取当前时间（MOCK_DATE_CTL）；
#   2) /dev/urandom（MOCK_RANDOM_CTL）—— 本机（Windows）没有这个设备，
#      签名随机数会退化成空串；
#   3) wget（MOCK_WGET_DIR）—— 记录「最终交给系统执行的命令行」并注入响应体 / 响应头（-S 形状）
#      / 失败 / 超时；
#   4) 设备命令 am / input / wm / dumpsys（MOCK_DEVICE_DIR）—— 本机没有 Android，
#      它们只在 /system/bin 下（不是 busybox applet）：记录命令行与 fd 见证，并注入
#      屏幕 / 活动输出。PATH 上的同名包装器由 tests/device.sh 生成（见下面的说明）。
#
# 环境变量（由包装脚本与用例设置）：
#   BB_REAL        真实 busybox 的路径（必需；Windows 上是 busybox.exe）
#   MOCK_DATE_CTL  形如「2026-10-01 22:05」的文件；只影响 +%Y-%m-%d / +%Y%m%d /
#                  +%H:%M / +%H / +%M / '+%Y-%m-%d %H:%M:%S'，其余格式（含 +%s）走真实时间。
#                  秒位没有可控来源，固定成 :00 —— 需要比对秒数的断言请只验格式（两位数字）。
#   MOCK_DATE_FMT  仅输出一个格式串时的回退格式（默认 +%s）
#   MOCK_DATE_NO_NANO 置位即模拟「这份 busybox 没编 FEATURE_DATE_NANO」：带 %N 的格式
#                  按「%N 不被支持」原样吐出（真机上出现过），其余格式一律不变
#   MOCK_RANDOM_CTL 随机数替身的序号文件（设了才接管，且每次调用都不同）
#   MOCK_WGET_DIR  wget 替身的控制目录（设了才接管；见下面的说明）
#   MOCK_DEVICE_DIR 设备命令替身的控制目录（设了才接管；见下面的说明）
#
# 当前用例：多数只走「透传」这一半；tests/skeleton.sh 用 MOCK_DATE_CTL 真的拨钟
# （验 base 层的时间源），跨日/时点用例同样直接设它；tests/api.sh 用 MOCK_WGET_DIR
# 断言网络调用的命令行与响应注入；tests/device.sh 用 MOCK_DEVICE_DIR 断言设备命令
# 的命令行与 fd 加固。降权链路（su）的替身不在这里——它由 tests/notify.sh 自己生成，
# 因为探测里套了 timeout、命令最终由别的进程 fork 出去，必须落在文件上。
# ============================================================
BB_REAL="${BB_REAL:-busybox}"
MOCK_DATE_FMT="${MOCK_DATE_FMT:-+%s}"

# 拿不到真实 busybox 时明确失败：此时 exec 自己会变成 fork 炸弹，
# 而「找不到 busybox」在测试日志里表现为「全部断言莫名超时」，极难排查。
# 判据：PATH 上要有一个**真的 busybox 文件**；若它是 busybox ash 的内建 applet
# （`command -v` 只回一个名字），那也能用——但名字不是文件，不能当成路径。
if [ "$BB_REAL" = "busybox" ]; then
  if ! command -v busybox >/dev/null 2>&1; then
    echo "mock: 拿不到真实 busybox（BB_REAL 未设置，PATH 里也没有）；" >&2
    echo "mock: 请设置 TEST_BUSYBOX=<路径>，或把 busybox 放到 tools/busybox/。" >&2
    exit 127
  fi
fi

# ---- 分派前缀：applet 名不一定在 $1 ----
# 调用方有两种形状：CI/设备上直接跑 mock 时 applet 在 `$1`；本机（Windows）经
# `busybox.exe sh <脚本> date …` 起时，解释器会多留一个 `sh`，applet 就跑到 `$2` 上。
# 若等到文件末尾才剥离，下面这些**按位置参数判 applet** 的接管档在本机全部失灵
# （MOCK_TZ / MOCK_EPOCH / MOCK_DATE_CTL 都受影响），断言看着在跑其实没测到。
# 故在这里统一成「$1 永远是 applet 名」，后面所有档都按同一个位置判。
_bb_applet="$1"
if [ "$1" = "sh" ] && [ -n "${2:-}" ]; then
  shift
  _bb_applet="$1"
fi

# ---- date 的**可选特性**：不是每份 busybox 都编了 FEATURE_DATE_NANO ----
# 没编进去时 `date +%s%3N` 会把 `%3N` 原样吐出来（Ubuntu 的 busybox-static 就是这样），
# 于是「耗时」只能退化成秒——而「窗口刚开那几秒」正是要靠它分辨的。
# 要断言「退化之后仍拿到毫秒」，就得能造出这个环境事实，故这里只接管带 %N 的格式。
if [ "$1" = "date" ] && [ -n "${MOCK_DATE_NO_NANO:-}" ]; then
  # 模块要的是 `+%s%3N`，纳秒段写作 `%3N`（不是 `%N`）——两种形状都认，
  # 免得日后换成 `+%N` 时这条替身静默失效（那正是「断言看着在跑、其实空转」）
  case "$2" in
    *%3N*|*%N*) printf '%s%%3N\n' "$("$BB_REAL" date +%s)"; exit 0 ;;
  esac
fi

# ---- 时区偏移的**取不到**那一档：`date +%z` 与 `date -u +%s` 一起失效时，
# base 的 tz_offset 要走「本地秒减 UTC 秒」的退化路径。两个读数分别由
# MOCK_EPOCH_LOCAL / MOCK_EPOCH_UTC 给出（不设则透传真实时间）。
# 判据用 `$*`（整串）而不是位置参数：上面的分派前缀会 shift，位置会往后挪一位，
# 按 `$2`/`$3` 判会漏掉（`date -u +%s` 就会漏，于是 tz_offset 走了真实时间那条路）。
# 必须排在 MOCK_TZ 那一档之前：退化路径的前提是 `%z` 也拿不到，两个控制项会同时出现。
case "$*" in
  "date +%s")
    [ -n "${MOCK_EPOCH_LOCAL:-}" ] && { printf '%s\n' "$MOCK_EPOCH_LOCAL"; exit 0; } ;;
  "date -u +%s")
    # 只给了 MOCK_EPOCH_LOCAL 时，UTC 读数就取它（差值 0）——这样「偏移为零」与
    # 「偏移判不出来」两档不会互相串。
    [ -n "${MOCK_EPOCH_UTC:-}" ] && { printf '%s\n' "$MOCK_EPOCH_UTC"; exit 0; }
    [ -n "${MOCK_EPOCH_LOCAL:-}" ] && { printf '%s\n' "$MOCK_EPOCH_LOCAL"; exit 0; } ;;
esac

# ---- 时区：跑测机器的时区是「环境事实」，不该让断言随它变（CI 跑在 UTC 上、
# 开发机常常是 +0800——同一个断言在两边结果不同，就是假红灯/假绿灯的来源）。
# MOCK_TZ 设了就让 `date +%z` **原样**回这个值，包括 `--` 这类**假值**：那一档专门用来
# 造「偏移判不出来」。所以这里不能只认 `[+-]????` 的合法形状——只认合法值时，假值会
# 悄悄透传给真实 date，断言就成了「看着在跑、其实没测到东西」。
# 与 MOCK_DATE_CTL 分开放：那个控制项只管「现在几点」，两者可各自独立设定。
if [ "$1" = "date" ] && [ "$2" = "+%z" ] && [ -n "${MOCK_TZ:-}" ]; then
  printf '%s\n' "$MOCK_TZ"; exit 0
fi

if [ "$1" = "date" ] && [ -n "${MOCK_DATE_CTL:-}" ] && [ -f "$MOCK_DATE_CTL" ]; then
  _d=$(cat "$MOCK_DATE_CTL")
  _fmt="${2:-$MOCK_DATE_FMT}"
  case "$_fmt" in
    +%Y-%m-%d) echo "${_d%% *}" ;;
    +%Y%m%d)   echo "${_d%% *}" | tr -d '-' ;;
    +%H:%M)    echo "${_d#* }" ;;
    +%H)       echo "${_d#* }" | cut -d: -f1 ;;
    +%M)       echo "${_d#* }" | cut -d: -f2 ;;
    # 完整时间戳（日志与保活统计用）：秒位无可控来源，固定 :00
    '+%Y-%m-%d %H:%M:%S') printf '%s %s:00\n' "${_d%% *}" "${_d#* }" ;;
    # 未接管的格式（含 +%s 与带空格的完整时间戳）走真实时间。
    # 这里必须先 shift 掉 applet 名：本文件是「busybox 替身」，$1 永远是 applet
    *)         shift; "$BB_REAL" date "$@" ;;
  esac
  exit 0
fi

# ---- /dev/urandom：本机（Windows）没有这个设备 ----
# 签名用的随机数取自它；设备不存在时 head 会失败、随机数退化成空串，
# 「16 位字母数字」这条契约就没法在本地断言。**只在 MOCK_RANDOM_CTL 被设置时接管**
# （与 wget 同样的口径：不设置就透传真实设备）。替身给出 24 字节内容（全是字母数字，
# base64 之后仍是字母数字，正好够 tr + head 截出 16 位），序号放在**开头**——
# 随机数只取 base64 的前 16 位（= 前 12 字节），序号放结尾就变不成不同的值。
if [ "$1" = "head" ] && [ -n "${MOCK_RANDOM_CTL:-}" ] && [ "$4" = "/dev/urandom" ]; then
  _seq=$(cat "$MOCK_RANDOM_CTL" 2>/dev/null | tr -dc '0-9')
  _seq=$(( ${_seq:-0} + 1 ))
  printf '%s\n' "$_seq" > "$MOCK_RANDOM_CTL" 2>/dev/null
  printf '%06dmockrandomabcdefgh' "$_seq"
  exit 0
fi

# ---- wget：仅当 MOCK_WGET_DIR 被设置时接管 ----
# 控制文件都在该目录下（用例与驱动脚本用相对路径，CWD 是驱动脚本所在目录）：
#   help    wget --help 的输出 → 决定 api 层是否探测到 -T 超时选项
#   body    调用的响应体
#   rc      调用的退出码（缺省 0）
#   stderr  调用的报错正文（工具自己那句，形如 `wget: server returned error: …`）
#   hdr     服务端响应原文，**按真实 -S 形状**（首行状态行 + 若干缩进两格的头行）；
#           设了内容就整段写到 stderr（在 stderr 那个文件之前——真实 wget 也是先读到响应、
#           再报错）。要断言「拿不到响应头」那一档就把它清空
#   calls   每次调用的**逐个参数**追加一行（由用例自己清空）
if [ "$1" = "wget" ] && [ -n "${MOCK_WGET_DIR:-}" ]; then
  if [ "$2" = "--help" ]; then
    [ -f "$MOCK_WGET_DIR/help" ] && cat "$MOCK_WGET_DIR/help"
  else
    # 参数逐个落盘、用 | 分隔：$* 会把参数边界抹平，「一个含空格的参数」与
    # 「两个参数」在记录里长得一模一样，命令行断言就悬空了
    { for _a in "$@"; do printf '%s|' "$_a"; done; printf '\n'; } >> "$MOCK_WGET_DIR/calls" 2>/dev/null
    cat "$MOCK_WGET_DIR/hdr" >&2 2>/dev/null
    cat "$MOCK_WGET_DIR/stderr" >&2 2>/dev/null
    cat "$MOCK_WGET_DIR/body" 2>/dev/null
    _rc=$(cat "$MOCK_WGET_DIR/rc" 2>/dev/null | tr -dc '0-9')
    exit "${_rc:-0}"
  fi
  exit 0
fi

# ---- 分派前缀：本机（Windows）的包装器靠 `#!<busybox> sh` 才可执行，解释器会把
# 一个多余的 `sh` 留在参数最前面。设备命令的包装器同样如此，故这一处统一剥掉
# （也避免 `set -- $*` 那种把参数边界抹平的写法）。
_bb_applet="$1"
[ "$_bb_applet" = "sh" ] && shift && _bb_applet="${1:-}"

# ---- 设备命令：仅当 MOCK_DEVICE_DIR 被设置时接管 ----
# am / input / wm / dumpsys 在真机上是 /system/bin 下的独立程序（不是 busybox applet），
# 被测层通过 PATH 调用它们。要用替身顶掉它们，就得在 PATH 上放同名文件——
# tests/device.sh 的 dv_setup 会把四个包装器放进 $DV_WORK/bin 并把它排到 PATH 最前，
# 包装器再调本文件（busybox 替身）的对应 applet；包装器的生成见 dv_tools。
#
# 控制文件（用例与驱动脚本用相对路径，CWD 是驱动脚本所在目录）：
#   power.txt     dumpsys power 的输出（屏幕状态判定的夹具）
#   activity.txt  dumpsys activity activities 的输出（任务枚举的夹具）
#   rc            设备命令的退出码（缺省 0）
#   calls         命令行记录（stdout 追加）：行首一列是 fd 见证，其后是 `|` 分隔的逐个参数
#
# 行首那一列是 stdout 的 fd 见证（见 tests/device.sh 「能力收口与 fd 加固」一节的说明）：
#   `-` = 没接到普通文件（重定向到 dev/null、或管道，都算「命令自身不写任何文件」）；
#   `file` = 接到了普通文件（危险：KernelSU 的 SELinux 会拒绝向 /data/adb 下文件传 binder fd）。
# 它只在 fd 真的指向普通文件时报警，所以是「加固是否还在」的负向守卫，
# 而不是「加固写法」的证明——写法由 tests/device.sh 的静态命令位判据钉住。
if [ -n "${MOCK_DEVICE_DIR:-}" ]; then
  _mock_dev_applet=""
  _mock_dev_fixture=""
  case "$_bb_applet" in
    am|input|wm) _mock_dev_applet="$_bb_applet" ;;
    dumpsys)
      # 两个子命令（power / activity activities）分开注入；未注入时输出为空
      case "$2" in
        power)    _mock_dev_applet="dumpsys"; _mock_dev_fixture="power.txt" ;;
        activity) _mock_dev_applet="dumpsys"; _mock_dev_fixture="activity.txt" ;;
      esac
      ;;
  esac
  if [ -n "$_mock_dev_applet" ]; then
    _mock_dev_fd="-"
    if [ -f /dev/stdout ]; then _mock_dev_fd="file"; fi
    { printf '%s' "$_mock_dev_fd"; for _a in "$@"; do printf '|%s' "$_a"; done; printf '\n'; } \
      >> "$MOCK_DEVICE_DIR/calls" 2>/dev/null
    # 可选：把「设备命令发生了」这件事追加到调用方指定的时间线文件里。
    # 要断言「通知早于开页」这类**跨进程的先后**时用它——两个动作落到同一条时间线，
    # 顺序才是可比的（各自的记录文件之间没有可比的时间基准）。
    [ -n "$MOCK_DEVICE_LOG" ] && printf 'device %s\n' "$_mock_dev_applet" >> "$MOCK_DEVICE_LOG" 2>/dev/null
    if [ -n "$_mock_dev_fixture" ]; then
      [ -f "$MOCK_DEVICE_DIR/$_mock_dev_fixture" ] && cat "$MOCK_DEVICE_DIR/$_mock_dev_fixture"
    fi
    _mock_dev_rc=$(cat "$MOCK_DEVICE_DIR/rc" 2>/dev/null | tr -dc '0-9')
    exit "${_mock_dev_rc:-0}"
  fi
fi

exec "$BB_REAL" "$@"
